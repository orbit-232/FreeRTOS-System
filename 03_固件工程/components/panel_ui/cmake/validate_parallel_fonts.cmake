# Parallel software rendering must never reintroduce the shared RLE decoder
# or the unprotected global shadow cache into this firmware.
function(panel_assert_parallel_fonts font_dir draw_units shadow_cache)
    if(draw_units LESS_EQUAL 1)
        return()
    endif()
    if(shadow_cache GREATER 0)
        message(FATAL_ERROR "Parallel SW drawing requires shadow cache 0 (shared cache has no mutex)")
    endif()
    if(CONFIG_LV_FONT_MONTSERRAT_28_COMPRESSED)
        message(FATAL_ERROR "Compressed built-in font is forbidden with parallel SW drawing")
    endif()
    file(READ "${font_dir}/ui_font_meta.h" font_meta)
    if(NOT font_meta MATCHES "#define[ \t]+UI_FONT_ACTIVE_COMPRESSED[ \t]+0")
        message(FATAL_ERROR "Parallel SW drawing requires generated raw font metadata")
    endif()
    file(GLOB generated_fonts "${font_dir}/ui_font_*.c")
    list(LENGTH generated_fonts font_count)
    if(NOT font_count EQUAL 7)
        message(FATAL_ERROR "Re-audit the font inventory before enabling parallel drawing")
    endif()
    foreach(font IN LISTS generated_fonts)
        file(READ "${font}" contents)
        string(REGEX MATCHALL "\\.bitmap_format[ \t]*=[ \t]*[0-9]+" formats "${contents}")
        if(NOT formats)
            message(FATAL_ERROR "Cannot establish actual bitmap encoding: ${font}")
        endif()
        foreach(format IN LISTS formats)
            if(NOT format MATCHES "=[ \t]*0$")
                message(FATAL_ERROR "Compressed font descriptor is forbidden with parallel drawing: ${font}")
            endif()
        endforeach()
    endforeach()
endfunction()
